    s = sub.add_parser("usage", help="read-only: tickets, launches, rework, first-pass acceptance, review findings "
                                     "per round, wall time and tokens per group, over one or more runs")
    s.add_argument("runs", nargs="*", metavar="RUN", help="default: the run changed most recently")
    s.add_argument("--all", action="store_true", help="every run in this checkout")
    s.add_argument("--by", choices=USAGE_BY, default="ticket", help="group by (default ticket)")
    s.add_argument("--json", action="store_true", help="print the groups, totals and every ticket's numbers")
    s.set_defaults(fn=cmd_usage)

    s = sub.add_parser("status", help="workers and their report status; --brief: one line per worker of every run "
                                      "with a live worker (read-only, no lock)")
    s.add_argument("run", nargs="?", help="required without --brief; with it, default every run with a live worker")
    s.add_argument("--json", action="store_true")
    s.add_argument("--brief", action="store_true",
                   help="one line per worker: live or not, provider:model, what it is doing, wall time and tokens "
                        "when known; prints nothing when no worker is live (no run named)")
    s.add_argument("--all", action="store_true",
                   help="with --brief: every active Fleet checkout on this computer, this one first")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("wait", help="block until a report reaches needs-verification or blocked, or a worker "
                                    "exits, stalls, becomes unreachable, or (with hooks) shows a permission prompt "
                                    "or goes idle (exit 0), or timeout (exit 2)")
    watch_args(s)
    s.add_argument("--any-change", action="store_true", help="wake on any report change, whatever its status")
    s.add_argument("--gate", action=argparse.BooleanOptionalAction, default=None,
                   help="run a live writer's planned checks on its hand-back before waking you, and send a failure "
                        "back to it, up to defaults.gate_rounds times (default: defaults.gate, off)")
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("supervise", help="wait in the background and take the mechanical steps the owner opted into "
                                         "(gate, review, dispatch), waking you only for a judgment call or a ticket "
                                         "ready to accept (exit 0), or timeout (exit 2)")
    watch_args(s)
    s.add_argument("--auto", metavar="STEPS",
                   help=f"comma-separated steps from {', '.join(SUPERVISE_STEPS)} (default: defaults.supervise, "
                        "gate); gate alone is wait --gate")
    s.set_defaults(fn=cmd_supervise)

    s = sub.add_parser("stop", help="send each worker its quit sequence")
    s.add_argument("run")
    s.add_argument("ids", nargs="*")
    s.add_argument("--all", action="store_true")
    s.add_argument("--close", action="store_true", help="close tab only after confirmed process exit")
    s.add_argument("--timeout", type=float, default=10)
    s.set_defaults(fn=cmd_stop)

    s = sub.add_parser("agents", help="owner's view: browse a run's workers and watch or attach to any one "
                                      "(arrow keys; --list prints them)")
    s.add_argument("run", nargs="?", help="default: the run changed most recently")
    s.add_argument("--list", action="store_true", help="print the workers and how to open each, without the browser")
    s.set_defaults(fn=cmd_agents)

    s = sub.add_parser("statusline", help="owner's view in Claude Code's status line: a row per live Fleet worker "
                                          "below your own line; --install puts it in Claude Code's settings")
    s.add_argument("--then", metavar="COMMAND", help="your own status-line command: run first with the same input, "
                                                     "its output printed above Fleet's rows")
    s.add_argument("--rows", type=int, default=BRIEF_ROWS, help=f"worker rows before +k more (default {BRIEF_ROWS})")
    s.add_argument("--install", action="store_true",
                   help="set Claude Code's statusLine to this, chaining the one there now; the file is backed up first")
    s.add_argument("--uninstall", action="store_true", help="put back the statusLine --install replaced")
    s.add_argument("--scope", choices=["user", "project"], default="user",
                   help="with --install or --uninstall: ~/.claude/settings.json (default) or this checkout's "
                        ".claude/settings.local.json")
    s.add_argument("--settings", help=argparse.SUPPRESS)  # the installer's: the exact settings file, beside its skill
    s.set_defaults(fn=cmd_statusline)

    s = sub.add_parser("dashboard", help="owner's view in a browser: a local read-only page of every active Fleet "
                                         "checkout's workers and their screens, on 127.0.0.1 with a token in its link")
    s.add_argument("--port", type=int, default=0, help="default 0: a free port")
    s.add_argument("--open", action="store_true", help="open the page in your browser (not on Linux)")
    s.add_argument("--background", action="store_true",
                   help="start one detached dashboard for this computer, or reuse the one running, and print its link")
    s.add_argument("--stop", action="store_true",
                   help="stop the background dashboard, until the next init or launch that starts one")
    s.add_argument("--detached", action="store_true", help=argparse.SUPPRESS)  # what --background starts
    s.add_argument("--idle-exit", type=float, default=DASHBOARD_IDLE_S, help=argparse.SUPPRESS)
    s.add_argument("--idle-check", type=float, default=DASHBOARD_CHECK_S, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_dashboard)

    s = sub.add_parser("track", help="owner's view in a terminal: every active Fleet session on this computer, "
                                     "redrawn live (Ctrl-C quits); --pane opens it below, in tmux or cmux")
    s.add_argument("--run", help="only this run of this checkout")
    s.add_argument("--interval", type=float, default=2.0, help="seconds between redraws (default 2)")
    s.add_argument("--exit-when-idle", type=float, metavar="MINUTES",
                   help="end after this many minutes with no live worker (default: run until Ctrl-C)")
    s.add_argument("--pane", action="store_true",
                   help="open fleet track in a short pane below this one, without focus, in tmux or cmux; reuses the "
                        "one it opened there")
    s.set_defaults(fn=cmd_track)

    s = sub.add_parser("attach", help="owner's view: open one worker's terminal (tmux attach; cmux names its tab)")
    s.add_argument("run")
    s.add_argument("id")
    s.add_argument("--read-only", action="store_true", help="watch without being able to type into the worker")
    s.set_defaults(fn=cmd_attach)

    s = sub.add_parser("check", help="compare HEAD and index with the captured baseline; in a worktree run, also "
                                     "list the run's worktrees and flag orphans")
    s.add_argument("run")
    s.add_argument("--clean-worktrees", action="store_true",
                   help="remove orphan worktrees: those of verified or dropped tickets, and unrecorded ones in the "
                        "run's worktree folder")
    s.set_defaults(fn=cmd_check)

    s = sub.add_parser("merge", help="apply a worktree ticket's diff to this checkout's working tree with plain git "
                                     "apply (never the index); CONFLICT, applying nothing, when it does not apply "
                                     "cleanly. fleet accept runs it")
    s.add_argument("run")
    s.add_argument("id")
    s.add_argument("--resolved", metavar="WHAT_YOU_DID",
                   help="after merging the ticket's files by hand, record the checkout's copies as its merge "
                        "(saved in decisions)")
    s.add_argument("--pick", metavar="WRITER_ID", help="for a best-of-two ticket: the writer whose diff to apply")
    s.set_defaults(fn=cmd_merge)

    s = sub.add_parser("handoff", help="at a safe point, save a handoff entry to notes.md and print the owner's "
                                       "steps to compact the lead or start a fresh one")
    s.add_argument("run")
    s.add_argument("--compact", action="store_true", help="prepare for compaction instead of a fresh lead")
    s.add_argument("--note", action="append", default=[],
                   help="a decision or owner preference not in the saved plan; repeat for each")
    s.add_argument("--no-notes", action="store_true", help="nothing beyond the saved plan needs saving")
    s.set_defaults(fn=cmd_handoff)

    s = sub.add_parser("context", help="show the calling lead's context size (and its zone, when [lead_context] marks are set)")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_context)

    s = sub.add_parser("steer", help="steer future launches to a specific provider or model")
    steer = s.add_subparsers(dest="steer_cmd", required=True)
    s_provider = steer.add_parser("provider", help="lock future launches to one provider")
    s_provider.add_argument("run")
    s_provider.add_argument("name", help="provider name")
    s_provider.set_defaults(fn=cmd_steer)
    s_model = steer.add_parser("model", help="set a model override")
    s_model.add_argument("run")
    s_model.add_argument("name", help="model name")
    s_model.set_defaults(fn=cmd_steer)
    s_reset = steer.add_parser("reset", help="drop steering overrides")
    s_reset.add_argument("run")
    s_reset.set_defaults(fn=cmd_steer)

    s = sub.add_parser("smoke", help="owner's live check of the real CLIs and accounts: one tiny ticket per provider "
                                     "through launch, wait --gate, review and accept in a throwaway repository; "
                                     "prints the plan unless --yes-paid")
    s.add_argument("--providers", metavar="A,B", help="comma-separated providers (default: every enabled one doctor passes, one "
                                       "per CLI)")
    s.add_argument("--yes-paid", action="store_true", help="run it: real sessions on the owner's accounts cost usage")
    s.add_argument("--keep", action="store_true", help="keep the throwaway repository and print its path")
    s.add_argument("--report", metavar="FILE", help="Markdown report path (default: fleet-smoke-<time>.md in the system temp "
                                    "directory, printed)")
    s.add_argument("--timeout", dest="step_timeout", type=int, default=300, metavar="SECONDS",
                   help="seconds each worker may take to hand back (default 300, at most 3600)")
    s.set_defaults(fn=cmd_smoke)

    s = sub.add_parser("import", help="read GitHub issues (read-only, with the owner's gh login) into local ticket "
                                      "files, the body fenced as untrusted data; needs no run")
    s.add_argument("refs", nargs="*", metavar="ISSUE", help="owner/repo#N, an issue URL, or N with --repo")
    s.add_argument("--dir", default=IMPORT_DIR,
                   help=f"folder for the ticket files, inside the repository and outside .fleet/ (default {IMPORT_DIR})")
    s.add_argument("--repo", metavar="OWNER/REPO", help="needed for bare issue numbers; for the filters it defaults "
                                                       "to gh's pick from this checkout's remote")
    s.add_argument("--label", action="append", help="import the issues with this label; repeat to require several")
    s.add_argument("--milestone", help="import the issues in this milestone (number or title)")
    s.add_argument("--state", choices=["open", "closed", "all"], default="open", help="with a filter (default open)")
    s.add_argument("--limit", type=int, default=100, help="with a filter, at most this many issues (default 100)")
    s.add_argument("--force", action="store_true", help="overwrite files, even ones edited since import")
    s.set_defaults(fn=cmd_import)

    s = sub.add_parser("hold", help="block new launches in this checkout; running workers continue")
    s.add_argument("--reason", help="shown to any lead that tries to launch")
    s.set_defaults(fn=cmd_hold)

    s = sub.add_parser("release", help="lift the hold so launches may continue")
    s.set_defaults(fn=cmd_release)

    try:
        a, extra = ap.parse_known_args(argv)
    except SystemExit:
        if argv and argv[0] == "statusline" and not {"--install", "--uninstall"} & set(argv):
            return 0  # Claude Code's status line: argparse has said what is wrong; it is never a failure there
        raise
    if a.cmd == "statusline" and not (a.install or a.uninstall):
        return statusline_show(a)  # before the config: a broken config never blanks the owner's status line
    if extra and a.cmd == "send" and not any(x.startswith("-") for x in extra):
        a.text += extra  # before Python 3.12, argparse leaves send's text unparsed when it follows an option
    elif extra:
        ap.error(f"unrecognized arguments: {' '.join(extra)}")
    if a.cmd == "version":  # no config: a broken config must not hide the version
        return cmd_version(a, None) or 0
    try:
        if getattr(a, "id", None) is not None:  # launch --ready names no ticket
            valid_id(a.id)
        if getattr(a, "run", None) is not None:  # agents may pick the latest run itself
            valid_id(a.run)
        elif a.cmd == "status" and not a.brief:  # before the lock, which would make .fleet/ in a fresh checkout
            raise FleetError("status needs a run; fleet status --brief lists every run with a live worker")
        limit = WAIT_MAX if a.cmd in ("wait", "supervise") else 60
        if hasattr(a, "timeout") and not 0 <= a.timeout <= limit:
            raise FleetError(f"timeout must be between 0 and {limit} seconds")
        if getattr(a, "settle", None) is not None and not 0 <= a.settle <= 30:
            raise FleetError("settle must be between 0 and 30 seconds")
        if hasattr(a, "stall") and a.stall < 0:
            raise FleetError("stall must be 0 (off) or a number of seconds")
        if hasattr(a, "interval") and not 0 < a.interval <= 60:
            raise FleetError("interval must be between 0 and 60 seconds")
        cfg = load_config()
        try:
            with mutation_lock(a):
                code = a.fn(a, cfg) or 0
            if follow := getattr(a, "unlocked", None):
                code = code or follow() or 0  # what runs after the lock can fail the command: NOT STARTED
            return code
        finally:
            if getattr(a, "run", None) is not None and a.cmd not in (*OWNER_VIEWS, "note") \
                    and not getattr(a, "brief", False):  # a worker runs note; --brief writes no .seen marker
                emit_lead_notice(a, cfg)
    except (FleetError, OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as e:
        print(f"fleet: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
