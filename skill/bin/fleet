    s.add_argument("--launch-ready", action="store_true", help="then launch every ticket that can start (launch --ready)")
    s.set_defaults(fn=cmd_accept)

    s = sub.add_parser("prompt", help="scaffold a worker prompt from the templates")
    s.add_argument("run")
    s.add_argument("id")
    s.add_argument("--ticket")
    s.add_argument("--review-of")
    s.add_argument("--diff")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_prompt)

    s = sub.add_parser("launch", help=f"launch a worker in a new cmux pane (at {MAX_PANES} panes, replace a finished worker's "
                       "pane or add a tab to an idle one) or a new tmux window")
    s.add_argument("run")
    s.add_argument("id", nargs="?")
    s.add_argument("provider", nargs="?")
    s.add_argument("--tier", choices=["heavy", "standard", "light", "review"], help="default standard")
    s.add_argument("--model")
    s.add_argument("--effort")
    s.add_argument("--family", help="known family for an account-specific model override")
    s.add_argument("--pane", help="split this pane (ref, UUID or index; at the pane limit, replace it or add a tab) "
                   "instead of choosing one")
    s.add_argument("--settle", type=float,
                   help=f"seconds before launch prints the worker's screen (default {LAUNCH_SETTLE_S}; 0 skips it)")
    s.add_argument("--resume", action="store_true",
                   help="continue the stopped worker's own CLI session (same account), e.g. after a usage limit resets")
    s.add_argument("--ready", action="store_true",
                   help="launch every ticket that can start now on its saved assignment; no screens are printed")
    s.add_argument("--extra-round", metavar="REASON", help=extra_help)
    s.set_defaults(fn=cmd_launch)

    s = sub.add_parser("send", help="save a message in the ticket's inbox and type a one-line pointer to it")
    s.add_argument("run")
