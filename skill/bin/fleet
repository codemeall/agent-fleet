    s.add_argument("text", nargs="*", help="the message; or use --file")
    s.add_argument("--file", help="read the message from this file; - reads stdin")
    s.add_argument("--changes", action="store_true",
                   help="request changes: set the needs-verification report to changes-requested first")
    s.add_argument("--key", help="a retry with a key already used for this ticket sends nothing")
    s.add_argument("--findings", action="store_true",
                   help="send the latest reviewer's findings, numbered and quoted as data, to the stopped writer and "
                        "relaunch it (--resume where its adapter can) to fix or rebut each one")
    s.add_argument("--extra-round", metavar="REASON", help="with --findings: " + extra_help)
    s.set_defaults(fn=cmd_send)

    s = sub.add_parser("peek", help="read the bottom of a worker's screen")
    s.add_argument("run")
    s.add_argument("id")
    s.add_argument("--lines", type=int, default=20, help="raise it when a dialog or error is cut off")
    s.set_defaults(fn=cmd_peek)

    s = sub.add_parser("note", help="a worker adds one line to the run's team board; @lead wakes the lead, @<id> "
                                    "points that worker to it (no lock, no keystrokes)")
